{
  "manifest_version": 3,
  "name": "Resource Remix",
  "version": "0.1.0",
  "description": "Redirect page resources to local or remote replacement URLs for development.",
  "icons": {
    "16": "icons/resource-remix.svg",
    "32": "icons/resource-remix.svg",
    "48": "icons/resource-remix.svg",
    "128": "icons/resource-remix.svg"
  },
  "action": {
    "default_title": "Resource Remix",
    "default_icon": {
      "16": "icons/resource-remix.svg",
      "32": "icons/resource-remix.svg",
      "48": "icons/resource-remix.svg",
      "128": "icons/resource-remix.svg"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
